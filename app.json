{
  "expo": {
    "name": "rn-UI-Challenge",
    "slug": "rn-UI-Challenge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "rnuichallenge",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.lutricia.rnUIChallenge",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F8D52D",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lutricia.rnUIChallenge"
    },
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8D52D",
          "image": "./assets/images/logo.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c84a92f2-3409-437b-aeed-b0ac0f3c5c9c"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c84a92f2-3409-437b-aeed-b0ac0f3c5c9c"
    },
    "owner": "lutricia"
  }
}
